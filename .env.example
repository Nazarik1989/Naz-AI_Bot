# Telegram
BOT_TOKEN=123456789:telegram_bot_token_here
ADMIN_ID=123456789
CHANNEL_ID=@your_channel_username

# OpenRouter
OPENAI_API_KEY=sk-or-v1-your_openrouter_key_here
MODEL_NAME=openai/gpt-5.4
CONTENT_MODEL_NAME=openai/gpt-5.4-mini
OPENROUTER_SITE_URL=https://replit.com
APP_NAME=Naz_AI_Bot

# Hugging Face images
HF_TOKEN=hf_your_huggingface_token_here
HF_MODEL=black-forest-labs/FLUX.1-schnell
ALLOW_IMAGE_FALLBACK=true
REQUIRE_IMAGES_FOR_CHANNEL_POSTS=true
CHANNEL_IMAGE_COUNT=1

# Bot behavior
BOT_TIMEZONE=Europe/Moscow
AUTOPOST_ENABLED=true
AUTOPOST_TIMES=10:00,20:00
AUTOPOST_TASKS=post,viral
AUTOPOST_INSIGHT_CHANCE=0.35
NAZ_STORIES_FILE=naz_stories.md
SOURCE_MONITOR_ENABLED=false
SOURCE_MONITOR_TIMES=12:00,18:00
MONITORED_SOURCES_FILE=monitored_sources.json
SOURCE_SEEN_FILE=.source_seen.json
AGENT_CONTENT_INBOX=content_inbox/agent_content
ADMIN_ONLY_CONTENT=true
MAX_TOKENS=550
TEMPERATURE=0.8

# SQLite
DB_PATH=naz_ai_bot.sqlite3
