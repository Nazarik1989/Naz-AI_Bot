# Telegram
BOT_TOKEN=123456789:telegram_bot_token_here
ADMIN_ID=123456789
CHANNEL_ID=@your_channel_username
NAZ_TELEGRAM_CHANNEL_ID=@your_naz_channel_username

# OpenRouter
OPENAI_API_KEY=sk-or-v1-your_openrouter_key_here
MODEL_NAME=openai/gpt-5.4
CONTENT_MODEL_NAME=openai/gpt-5.4-mini
OPENROUTER_SITE_URL=https://replit.com
APP_NAME=Naz_AI_Bot

# Images: OpenRouter/OpenAI-compatible first, then BFL, Hugging Face, local fallback
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_IMAGE_MODEL=openai/gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
IMAGE_PROVIDER=openai
BFL_API_KEY=your_bfl_api_key_here
BFL_MODEL=flux-2-pro
BFL_API_BASE=https://api.bfl.ai/v1
BFL_IMAGE_WIDTH=1024
BFL_IMAGE_HEIGHT=1024
BFL_POLL_INTERVAL_SECONDS=1
BFL_TIMEOUT_SECONDS=150
FALLBACK_IMAGE_DIR=assets/fallback_images
VISUAL_ARCHIVE_ENABLED=false
VISUAL_ARCHIVE_ROOT=images_curated
VISUAL_ARCHIVE_MANIFEST=images_curated/catalog/publication_candidates.json
VISUAL_ARCHIVE_STATE_FILE=.visual_archive_seen.json
VISUAL_ARCHIVE_REQUIRE_APPROVED=true
VISUAL_ARCHIVE_EVERY_N_POSTS=3
HF_TOKEN=hf_your_huggingface_token_here
HF_MODEL=black-forest-labs/FLUX.1-schnell
ALLOW_IMAGE_FALLBACK=true
REQUIRE_IMAGES_FOR_CHANNEL_POSTS=true
CHANNEL_IMAGE_COUNT=1

# Story-first private media packs (disabled by default; separate paid credential)
NAZ_STORY_RENDER_ENABLED=false
NAZ_STORY_PACK_ROOT=/var/lib/naz-ai-bot/story-packs
NAZ_VIDEO_PROVIDER=disabled
NAZ_VIDEO_API_KEY=runway_key_placeholder
NAZ_VIDEO_MODEL=gen4_turbo
NAZ_VIDEO_PRIMARY_MODEL=gen4_turbo
NAZ_VIDEO_SECONDARY_MODEL=gen4.5
NAZ_VIDEO_MODEL_PRIORITY=gen4_turbo,gen4.5
NAZ_VIDEO_AUTO_FALLBACK=false
NAZ_VIDEO_BASE_URL=https://api.dev.runwayml.com/v1
NAZ_VIDEO_HTTP_TIMEOUT_SECONDS=30
NAZ_VIDEO_POLL_TIMEOUT_SECONDS=900
NAZ_VIDEO_MAX_RETRIES=2
NAZ_VIDEO_DAILY_JOB_LIMIT=7
NAZ_VIDEO_DAILY_SECONDS_LIMIT=56
NAZ_STORY_MAX_SCENE_JOBS=7
NAZ_STORY_CONCURRENCY=1
NAZ_VIDEO_REFERENCE_DIR=/var/lib/naz-ai-bot/private/references
NAZ_STORY_MUSIC_LIBRARY=/var/lib/naz-ai-bot/private/music
NAZ_STORY_MUSIC_ROTATION_STATE=/var/lib/naz-ai-bot/story_music_rotation.json
# Stable Audio is a bounded manual library builder, never a timer/autofallback.
NAZ_AUDIO_PROVIDER=stability
NAZ_AUDIO_API_KEY=stability_key_placeholder
NAZ_AUDIO_MODEL=stable-audio-3
NAZ_AUDIO_BASE_URL=https://api.stability.ai
NAZ_AUDIO_HTTP_TIMEOUT_SECONDS=30
NAZ_AUDIO_MAX_RESPONSE_BYTES=52428800
NAZ_AUDIO_GENERATION_ENABLED=false
NAZ_STORY_PRIVATE_DELIVERY_ENABLED=true
NAZ_STORY_DELIVERY_INTERVAL_SECONDS=60
NAZ_STORY_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
NAZ_FFMPEG_BIN=ffmpeg
NAZ_FFPROBE_BIN=ffprobe
NAZ_MEDIA_TIMEOUT_SECONDS=180

# Voice messages: official OpenAI API, intentionally separate from OpenRouter
VOICE_MESSAGES_ENABLED=false
VOICE_MESSAGES_ADMIN_ONLY=true
VOICE_MESSAGES_CONTACTS_ENABLED=false
OPENAI_VOICE_API_KEY=sk-your_official_openai_key_here
OPENAI_VOICE_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Reserved for a later live speech-to-speech surface; GPT-Live can replace this when its API opens.
OPENAI_REALTIME_MODEL=gpt-realtime-2
VOICE_MAX_BYTES=15728640
VOICE_MAX_DURATION_SECONDS=300

# Bot behavior
BOT_TIMEZONE=Europe/Moscow
AUTOPOST_ENABLED=true
AUTOPOST_TIMES=10:00,14:00,18:00,22:00
AUTOPOST_TASKS=post,viral
NAZ_TELEGRAM_AUTO_ON=true
NAZ_TELEGRAM_AUTO_TIMES=10:00,14:00,18:00,22:00
NAZ_TELEGRAM_AUTO_TASKS=post,viral
AUTOPOST_INSIGHT_CHANCE=0.35
NAZ_STORIES_FILE=naz_stories.md
NAZ_STORIES_EXTRA_FILES=naz_stories_2.md
SOURCE_MONITOR_ENABLED=false
SOURCE_MONITOR_TIMES=12:00,18:00
MONITORED_SOURCES_FILE=monitored_sources.json
SOURCE_SEEN_FILE=.source_seen.json
NAZ_VK_ENABLED=false
NAZ_VK_PUBLIC_ID=
NAZ_VK_AUTO_ON=false
NAZ_VK_DAILY_TIME=10:30
NAZ_VK_GAMING_TIME=16:30
NAZ_VK_TIMEZONE=Europe/Moscow
NAZ_VK_SCHEDULER=systemd
NAZ_VK_QUEUE_DIR=/var/lib/void-vk-publisher/queue
NAZ_VK_TRACK_STATE_FILE=/var/lib/naz-ai-bot/vk_track_rotation.json
NAZ_VK_IMAGE_POLICY=required
NAZ_VK_IMAGE_ATTEMPTS=2
NAZ_VK_RECEIPT_SYNC_INTERVAL_SECONDS=300
NAZ_SCHEDULED_WORK_DIR=/var/lib/naz-ai-bot
AGENT_CONTENT_INBOX=content_inbox/agent_content
AGENT_CONTENT_SYNC_ENABLED=true
AGENT_CONTENT_SYNC_TIMES=23:57
AGENT_CONTENT_AUTO_PUBLISH=false
AGENT_CONTENT_RANDOM_SYNC=true
AGENT_CONTENT_REUSE_SEEN=false
AGENT_CONTENT_STATE_FILE=.agent_content_seen.json
CROSSPOST_EXCHANGE_ENABLED=true
CROSSPOST_EXCHANGE_AUTO_PUBLISH=true
CROSSPOST_EXCHANGE_DIR=/opt/bot_exchange
CROSSPOST_EXCHANGE_INTERVAL_SECONDS=300
CROSSPOST_EXCHANGE_MAX_PER_RUN=1
ADMIN_ONLY_CONTENT=true
MAX_TOKENS=550
TEMPERATURE=0.8

# SQLite
DB_PATH=naz_ai_bot.sqlite3
