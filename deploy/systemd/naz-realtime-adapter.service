[Unit]
Description=Naz local Realtime Voice adapter
After=local-fs.target

[Service]
Type=simple
User=naz
Group=voicehub-ipc
SupplementaryGroups=naz
WorkingDirectory=/opt/naz-ai-bot
EnvironmentFile=/opt/naz-ai-bot/.env
Environment=PYTHONUNBUFFERED=1
Environment=NAZ_ENV_LOADED_BY_SYSTEMD=1
Environment=NAZ_REALTIME_SOCKET=/run/naz-realtime/adapter.sock
RuntimeDirectory=naz-realtime
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/opt/naz-ai-bot/.venv/bin/python /opt/naz-ai-bot/naz_realtime_adapter_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/naz-ai-bot /run/naz-realtime

[Install]
WantedBy=multi-user.target
